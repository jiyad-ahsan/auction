DATABASE_URL=postgres://postgres@localhost:5432/auction
# Integration tests run against this database and wipe it.
TEST_DATABASE_URL=postgres://postgres@localhost:5432/auction_test

APP_URL=http://localhost:3000
SESSION_SECRET=change-me-to-a-long-random-string
# openssl rand -base64 32
APP_ENCRYPTION_KEY=
# Comma-separated E.164 numbers that become admins on first sign-in.
ADMIN_PHONES=+923000000000
# Shared secret for /api/cron/close-lots (sent as "Authorization: Bearer <secret>").
CRON_SECRET=change-me

NOTIFY_PROVIDER=console

# Shown to bidders on the deposit page. This must be the segregated client-money account.
DEPOSIT_ACCOUNT_TITLE="Your Company (Pvt) Ltd - Client Account"
DEPOSIT_BANK=Bank name
DEPOSIT_IBAN=PK00XXXX0000000000000000
DEPOSIT_RAAST_ID=
